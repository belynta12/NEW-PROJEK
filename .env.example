# =====================================================================
#  AVATAR AI LIFETIME - konfigurasi
#  Copy file ini menjadi .env  ->  cp .env.example .env
#  Semua isian OPSIONAL. Tanpa API key pun web tetap jalan
#  (mode DEMO: pakai suara & pengenal suara bawaan browser).
# =====================================================================

PORT=8787

# ---------------------------------------------------------------------
# 1) OTAK / LLM  (yang menjawab pertanyaan)
#    provider: groq | openai | openrouter | gemini | deepseek | ollama | browserless-off
#    REKOMENDASI MURAH: groq (ada free tier, sangat cepat)
# ---------------------------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Kosongkan untuk memakai model default preset
LLM_MODEL=
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=400

# ---------------------------------------------------------------------
# 2) SUARA MASUK / STT  (suara pengunjung -> teks)
#    provider: browser | groq | openai | deepgram
#    browser = GRATIS (Web Speech API, paling murah, butuh Chrome/Edge)
#    groq    = whisper-large-v3-turbo, ~$0.04 / jam audio (paling akurat & murah)
# ---------------------------------------------------------------------
STT_PROVIDER=browser
STT_LANGUAGE=id
DEEPGRAM_API_KEY=

# ---------------------------------------------------------------------
# 3) SUARA KELUAR / TTS  (teks -> suara ANDA)
#    provider: edge | browser | elevenlabs | fishaudio | openai
#    edge       = GRATIS, suara pria Indonesia natural (Microsoft Ardi), tanpa API key (default)
#    browser    = suara bawaan browser (robotik), dipakai otomatis bila server TTS gagal
#    fishaudio  = kloning suara Anda, murah, bagus untuk Bahasa Indonesia
#    elevenlabs = kloning suara Anda (Instant Voice Clone), kualitas terbaik
# ---------------------------------------------------------------------
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
# Isi setelah kloning suara: npm run clone-voice -- sample-suara.mp3 "Suara Saya"
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 = paling murah & cepat | eleven_multilingual_v2 = paling natural
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.85
ELEVENLABS_SPEED=1.0
# Alternatif murah, bagus untuk Bahasa Indonesia
FISHAUDIO_API_KEY=
FISHAUDIO_VOICE_ID=
# Simpan hasil TTS ke folder cache/ supaya jawaban yang sama tidak menghabiskan kredit
TTS_CACHE=1

# ---------------------------------------------------------------------
# 4) AVATAR  (foto yang bergerak)
#    mode: puppet | simli | did
#    puppet = GRATIS, tanpa API. Foto Anda dianimasikan di browser dengan
#             mesh 478 titik wajah: rahang, bibir (viseme a/i/u/e/o), kelopak,
#             alis, pipi, kepala bergerak; rongga mulut + gigi digambar.
#    simli  = streaming video WebRTC real-time (berbayar, ada tier gratis).
#    did    = D-ID streaming dari satu foto (butuh URL foto publik).
# ---------------------------------------------------------------------
AVATAR_MODE=puppet
# Simli: daftar gratis di https://app.simli.com (50 menit/bulan + kredit $10). Buat wajah dari
# foto Anda lewat dashboard (Create Avatar) atau: npm run simli-face -- foto.jpg "Nama Saya"
# Kosongkan SIMLI_FACE_ID untuk mencoba dengan wajah contoh Simli.
SIMLI_API_KEY=
SIMLI_FACE_ID=
# Sesi Simli dihitung per menit tersambung (termasuk saat diam). Setelah idle sekian detik sesi
# ditutup untuk hemat kuota dan tersambung lagi otomatis saat Anda bertanya. Maks 3600 / 300.
SIMLI_MAX_SESSION=900
SIMLI_MAX_IDLE=90
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
DID_API_KEY=
# Kosongkan: foto yang dipasang di web diunggah otomatis ke D-ID (/images).
# Isi hanya bila ingin memakai URL foto publik tertentu.
DID_SOURCE_URL=
# agents = API D-ID terbaru (gerak diam "fluent", latensi lebih rendah) | talks = API lama
DID_MODE=agents
DID_FLUENT=1
# Resolusi maksimum video (hanya mode talks): 150-1280. Kecil = lebih cepat.
DID_RESOLUTION=512
# URL https publik server ini, mis. https://avatar.domainanda.com (lihat docs/DEPLOY.md).
# Bila diisi, D-ID mengambil audio TTS langsung dari server ini tanpa unggah dulu
# (mulai bicara ~0,5-1 detik lebih cepat per kalimat). Kosongkan saat di localhost.
PUBLIC_BASE_URL=
# Deteksi wajah (mode puppet) memuat model MediaPipe dari CDN. Kosongkan untuk
# default; isi bila ingin memakai salinan sendiri (mis. server lokal).
VISION_TASKS_URL=
VISION_MODEL_URL=
VISION_DETECTOR_URL=

# ---------------------------------------------------------------------
# 5) PERSONA
# ---------------------------------------------------------------------
PERSONA_NAME=Avatar Saya
PERSONA_LANGUAGE=Bahasa Indonesia
PERSONA_STYLE=hangat, ramah, santai tapi berisi, bicara singkat seperti orang ngobrol
# Maksimal kalimat per jawaban (jawaban pendek = suara lebih murah & terasa natural)
PERSONA_MAX_SENTENCES=3
